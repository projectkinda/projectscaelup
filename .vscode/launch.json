{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Expo: Run on Android target",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\run-expo-emulator.ps1\" -Target \"${input:androidTarget}\""
    }
  ],
  "inputs": [
    {
      "id": "androidTarget",
      "type": "pickString",
      "description": "Choose an Android target",
      "options": [
        "RZCW3048QXL",
        "Resizable_Experimental",
        "S23_Ultra"
      ],
      "default": "RZCW3048QXL"
    }
  ]
}
